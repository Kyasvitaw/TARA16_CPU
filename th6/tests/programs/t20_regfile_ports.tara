; every register through read port A and read port B (TH3 regfile fault: port B could not read R7)
LIL R0, 0x10
LIL R1, 0x21
LIL R2, 0x32
LIL R3, 0x43
LIL R4, 0x54
LIL R5, 0x65
LIL R6, 0x76
LIL R7, 0x87
LIL R4, 0x54
SUB R0, R0, R1      ; port A R0, port B R1
SUB R1, R1, R2
SUB R2, R2, R3
SUB R3, R3, R4
SUB R4, R4, R5
SUB R5, R5, R6
SUB R6, R6, R7      ; port B = R7
ADD R7, R7, R7      ; both ports R7
XOR R0, R0, R7
HLT
